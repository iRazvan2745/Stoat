+<script lang="ts">
+  import type { Snippet } from "svelte";
+  import type { DivAttrs } from "../misc/typing-utils";
+
+  type Shape = "round" | "square";
+  type Size = "xs" | "s" | "m" | "l" | "xl";
+  type Variant = "connected" | "standard";
+
+  let {
+    children,
+    selected,
+    shape = "round",
+    size = "s",
+    variant = "connected",
+    ...extra
+  }: {
+    children: Snippet;
+    selected?: number;
+    shape?: Shape;
+    size?: Size;
+    variant?: Variant;
+  } & DivAttrs = $props();
+
+  let root = $state<HTMLDivElement>();
+  let internalSelected = $state(0);
+  const activeIndex = $derived(selected ?? internalSelected);
+
+  const items = (): HTMLElement[] =>
+    root ? [...root.querySelectorAll<HTMLElement>(":scope > .m3-container")] : [];
+
+  const isUnavailable = (item: HTMLElement): boolean =>
+    item.matches(":disabled") || Boolean(item.querySelector(":scope > input:disabled"));
+
+  $effect(() => {
+    const index = activeIndex;
+
+    for (const [i, item] of items().entries()) {
+      item.toggleAttribute("data-selected", i === index);
+    }
+  });
+
+  const onSelect = (event: MouseEvent): void => {
+    if (selected !== undefined || !root) {
+      return;
+    }
+
+    const target = event.target;
+    if (!(target instanceof Element)) {
+      return;
+    }
+
+    const item = target.closest(".m3-container");
+    if (!(item instanceof HTMLElement) || !root.contains(item) || isUnavailable(item)) {
+      return;
+    }
+
+    const index = items().indexOf(item);
+    if (index >= 0) {
+      internalSelected = index;
+    }
+  };
+</script>
+
+<div
+  bind:this={root}
+  class={["m3-container", "button-group", variant, `size-${size}`, variant === "connected" && shape]}
+  role="group"
+  {...extra}
+  onclick={onSelect}
+>
+  {@render children()}
+</div>
+
+<style>
+  .button-group {
+    --button-group-expand: 0.15;
+    --button-group-selected-scale: 1.85;
+    display: inline-flex;
+    max-width: 100%;
+    align-items: center;
+  }
+
+  .size-xs {
+    --button-group-min: 2rem;
+    --button-group-pad: 0.75rem;
+    --button-group-pressed: var(--m3-shape-small);
+    --inner-corner: var(--m3-shape-extra-small);
+    --inner-corner-active: var(--m3-shape-extra-small);
+  }
+
+  .size-s {
+    --button-group-min: 2.5rem;
+    --button-group-pad: 1rem;
+    --button-group-pressed: var(--m3-shape-small);
+    --inner-corner: var(--m3-shape-small);
+    --inner-corner-active: var(--m3-shape-extra-small);
+  }
+
+  .size-m {
+    --button-group-min: 3.5rem;
+    --button-group-pad: 1.5rem;
+    --button-group-pressed: var(--m3-shape-medium);
+    --inner-corner: var(--m3-shape-small);
+    --inner-corner-active: var(--m3-shape-extra-small);
+  }
+
+  .size-l {
+    --button-group-min: 6rem;
+    --button-group-pad: 3rem;
+    --button-group-pressed: var(--m3-shape-large);
+    --inner-corner: var(--m3-shape-large);
+    --inner-corner-active: var(--m3-shape-medium);
+  }
+
+  .size-xl {
+    --button-group-min: 8.5rem;
+    --button-group-pad: 4rem;
+    --button-group-pressed: var(--m3-shape-large);
+    --inner-corner: var(--m3-shape-large-increased);
+    --inner-corner-active: var(--m3-shape-large);
+  }
+
+  .standard.size-xs {
+    gap: 1.125rem;
+  }
+
+  .standard.size-s {
+    gap: 0.75rem;
+  }
+
+  .standard:is(.size-m, .size-l, .size-xl) {
+    gap: 0.5rem;
+  }
+
+  .connected {
+    gap: 0.125rem;
+  }
+
+  .button-group > :global(.m3-container) {
+    overflow: hidden;
+    white-space: nowrap;
+    transition:
+      border-radius var(--m3-easing-fast-spatial),
+      box-shadow var(--m3-easing-fast),
+      background-color var(--m3-easing-fast),
+      color var(--m3-easing-fast);
+  }
+
+  .button-group > :global(.m3-container:not(:disabled, :has(> input:disabled))) {
+    background-color: var(--m3c-surface-container) !important;
+    color: var(--m3c-on-surface-variant) !important;
+    box-shadow: none !important;
+    outline-color: transparent !important;
+  }
+
+  .button-group
+    > :global(
+      .m3-container:is([data-selected], [aria-pressed="true"], :has(> input:checked)):not(
+          :disabled,
+          :has(> input:disabled)
+        )
+    ) {
+    background-color: var(--m3c-primary) !important;
+    color: var(--m3c-on-primary) !important;
+  }
+
+  .standard > :global(.m3-container) {
+    flex: 0 0 auto;
+    transition:
+      width var(--m3-easing-fast-spatial),
+      min-width var(--m3-easing-fast-spatial),
+      max-width var(--m3-easing-fast-spatial),
+      padding-inline var(--m3-easing-fast-spatial),
+      border-radius var(--m3-easing-fast-spatial),
+      box-shadow var(--m3-easing-fast),
+      background-color var(--m3-easing-fast),
+      color var(--m3-easing-fast);
+  }
+
+  .standard
+    > :global(
+      .m3-container:is(
+          [data-selected],
+          [aria-pressed="true"],
+          :has(> input:checked)
+        ):not(:active)
+    ) {
+    border-radius: var(--m3-shape-full) !important;
+  }
+
+  .standard > :global(.m3-container:active:not(:disabled, :has(> input:disabled))) {
+    border-radius: var(--button-group-pressed) !important;
+  }
+
+  .standard
+    > :global(
+      .m3-container:not(.icon-full):is(
+          [data-selected],
+          [aria-pressed="true"],
+          :has(> input:checked)
+        )
+    ) {
+    padding-inline: calc(var(--button-group-pad) * var(--button-group-selected-scale)) !important;
+  }
+
+  .standard > :global(.m3-container:not(.icon-full):active:not(:disabled, :has(> input:disabled))) {
+    padding-inline: calc(var(--button-group-pad) * (1 + var(--button-group-expand))) !important;
+  }
+
+  .standard
+    > :global(
+      .m3-container:not(.icon-full):is(
+          [data-selected],
+          [aria-pressed="true"],
+          :has(> input:checked)
+        ):active:not(:disabled, :has(> input:disabled))
+    ) {
+    padding-inline: calc(
+      var(--button-group-pad) * var(--button-group-selected-scale) * (1 + var(--button-group-expand))
+    ) !important;
+  }
+
+  .standard > :global(.m3-container.icon-full) {
+    --_rest: var(--button-group-min);
+    width: var(--_rest) !important;
+    min-width: var(--_rest) !important;
+    max-width: var(--_rest);
+    aspect-ratio: 1;
+    padding-inline: 0 !important;
+  }
+
+  .standard
+    > :global(
+      .m3-container.icon-full:is([data-selected], [aria-pressed="true"], :has(> input:checked))
+    ) {
+    --_rest: calc(var(--button-group-min) * var(--button-group-selected-scale));
+    width: var(--_rest) !important;
+    min-width: var(--_rest) !important;
+    max-width: var(--_rest);
+    aspect-ratio: auto;
+    padding-inline: calc(var(--button-group-min) * 0.45) !important;
+  }
+
+  .standard > :global(.m3-container.icon-full:active:not(:disabled, :has(> input:disabled))) {
+    --_pressed: calc(var(--_rest) * (1 + var(--button-group-expand)));
+    aspect-ratio: auto;
+    width: var(--_pressed) !important;
+    min-width: var(--_pressed) !important;
+    max-width: var(--_pressed);
+  }
+
+  .standard > :global(.m3-container.icon-full:has(+ .m3-container:not(:first-child, :last-child):active)),
+  .standard > :global(.m3-container:not(:first-child, :last-child):active + .m3-container.icon-full) {
+    --_neighbor: calc(var(--_rest) * (1 - var(--button-group-expand) / 2));
+    width: var(--_neighbor) !important;
+    min-width: var(--_neighbor) !important;
+    max-width: var(--_neighbor);
+  }
+
+  .standard > :global(.m3-container:first-child:active + .m3-container.icon-full),
+  .standard > :global(.m3-container.icon-full:has(+ .m3-container:last-child:active)) {
+    --_neighbor: calc(var(--_rest) * (1 - var(--button-group-expand)));
+    width: var(--_neighbor) !important;
+    min-width: var(--_neighbor) !important;
+    max-width: var(--_neighbor);
+  }
+
+  .connected:is(.size-xs, .size-s) > :global(.m3-container) {
+    min-width: 3rem;
+  }
+
+  .connected > :global(.m3-container) {
+    --shape: var(--inner-corner);
+    --square-shape: var(--inner-corner);
+    --pressed-shape: var(--inner-corner-active);
+    border-radius: var(--inner-corner) !important;
+  }
+
+  .connected.round > :global(.m3-container:first-child) {
+    border-start-start-radius: var(--m3-shape-full) !important;
+    border-end-start-radius: var(--m3-shape-full) !important;
+  }
+
+  .connected.round > :global(.m3-container:last-child) {
+    border-start-end-radius: var(--m3-shape-full) !important;
+    border-end-end-radius: var(--m3-shape-full) !important;
+  }
+
+  .connected
+    > :global(
+      .m3-container:is(
+          [data-selected],
+          [aria-pressed="true"],
+          :has(> input:checked)
+        ):not(:active)
+    ) {
+    border-radius: var(--m3-shape-full) !important;
+  }
+
+  .connected > :global(.m3-container:active:not(:disabled, :has(> input:disabled))) {
+    border-radius: var(--inner-corner-active) !important;
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    .button-group > :global(.m3-container),
+    .standard > :global(.m3-container) {
+      transition:
+        box-shadow var(--m3-easing-fast),
+        background-color var(--m3-easing-fast),
+        color var(--m3-easing-fast);
