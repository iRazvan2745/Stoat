+  }
+
+  .item.selected .label > span:nth-child(2) {
+    color: var(--m3-menuitem-on-selected);
+  }
+
+  .icon {
+    width: 20px;
+    height: 20px;
+  }
+  .icon {
+    color: var(--m3-menuitem-icon);
+  }
+
+  .item:disabled {
+    color: --translucent(var(--m3-menuitem-text), 0.38);
+    cursor: auto;
+  }
+
+  .item:disabled > .icon > :global(svg) {
+    color: --translucent(var(--m3-menuitem-text), 0.38);
+  }
+</style>
