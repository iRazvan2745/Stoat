{
    "name": "@stoat/db",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./*": {
            "types": "./src/*.ts",
            "default": "./src/*.ts"
        }
    },
    "scripts": {
        "build": "tsc -b",
        "check-types": "tsc -b",
        "db:push": "drizzle-kit push",
        "db:generate": "drizzle-kit generate",
        "db:migrate:deploy": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "db:migrate": "drizzle-kit migrate"
    },
    "dependencies": {
        "drizzle-orm": "^0.45.2",
        "pg": "^8.23.0"
    },
    "devDependencies": {
        "@stoat/config": "workspace:*",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.10",
        "typescript": "catalog:",
        "varlock": "catalog:"
    }
}
