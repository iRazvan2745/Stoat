# Drizzle
# Inside the compose network use the db service name: postgres://user:password@localhost:5432/database
# For host-side tooling (drizzle-kit) you can publish the db port and use localhost instead.
DATABASE_URL=postgres://stoat:stoat@localhost:5434/stoat

ORIGIN=""

# Uncloud
# The API origin only; the generated paths already include /api/v1.
UNCLOUD_API=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Root directory for data sources
DATA_DIR=./data
