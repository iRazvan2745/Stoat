# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/generated-env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Server-only OAuth application configuration. See README.md for the JSON format.
# @type=string @required=false
GIT_OAUTH_PROVIDERS=[]

# Exact private Git hostnames/IPs allowed for self-hosted servers.
# @type=string @required=false
STOAT_GIT_ALLOWED_HOSTS=
