DOMAIN=
TZ=Europe/Bucharest
REDIS_URL=redis://calagopus-cache.internal
DATABASE_URL=postgresql://panel:${POSTGRES_PASSWORD}@calagopus-db.internal/panel
DATABASE_MIGRATE=true
PORT=8000
AIO_BASE_WINGS_CONFIGURATION=/wings-config.yml
APP_DEBUG=false
APP_LOG_DIRECTORY=/var/log/calagopus
APP_PRIMARY=true
APP_ENABLE_WINGS_PROXY=true
APP_ENCRYPTION_KEY={{ UUID }}
APP_USE_DECRYPTION_CACHE=true
APP_USE_INTERNAL_CACHE=true
POSTGRES_USER=panel
POSTGRES_PASSWORD={{ UUID }}
POSTGRES_DB=panel
PGDATA=/data
